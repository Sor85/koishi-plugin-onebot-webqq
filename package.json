{
  "name": "koishi-plugin-onebot-webqq",
  "description": "提供 OneBot WebQQ，为 ChatLuna 提供特殊适配，支持显示对话输入输出、思考状态、character 的 think 字段、affinity 的好感度显示、schedule的 日程显示",
  "version": "1.6.1",
  "type": "commonjs",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Sor85/koishi-plugin-onebot-webqq",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sor85/koishi-plugin-onebot-webqq.git"
  },
  "scripts": {
    "clean": "shx rm -rf lib dist",
    "build": "yarn clean && yarn build:server && yarn build:client",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:server": "yarn build:types && tsup src/index.ts --format cjs --out-dir lib --clean false",
    "watch:server": "node scripts/watch-server.mjs",
    "build:client": "vite build --config vite.config.mts",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run tests",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "bot",
    "chatbot",
    "koishi",
    "plugin",
    "console"
  ],
  "koishi": {
    "public": [
      "dist"
    ],
    "description": {
      "zh": "提供 OneBot WebQQ，为 ChatLuna 提供特殊适配，支持显示对话输入输出、思考状态、character 的 think 字段、affinity 的好感度显示、schedule的 日程显示"
    },
    "service": {
      "optional": [
        "console",
        "server",
        "database",
        "chatluna",
        "chatluna_character",
        "ffmpeg",
        "chatluna_schedule"
      ]
    }
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "koishi": "^4.18.10"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    }
  },
  "dependencies": {
    "@koishijs/console": "^5.30.11",
    "@tabler/icons-vue": "^3.45.0",
    "@vueuse/core": "^14.3.0",
    "animejs": "4.5.0",
    "qface": "^1.4.1",
    "reka-ui": "^2.10.1"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "2.5.0",
    "happy-dom": "20.12.0",
    "koishi": "^4.18.9",
    "sass": "^1.77.0",
    "shx": "^0.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "vue": "^3.5.12",
    "vue-tsc": "^3.3.4"
  },
  "packageManager": "yarn@4.15.0"
}
